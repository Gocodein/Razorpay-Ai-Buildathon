# ─── Razorpay test-mode credentials ───────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys (switch to Test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ─── LLM Provider (Choose: "gemini" | "groq" | "claude" | "openai" | "offline")
LLM_PROVIDER=gemini

# ─── 1. Google Gemini API (Recommended & 100% Free: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.0-flash

# ─── 2. Groq Cloud (Free & Ultra-Fast: https://console.groq.com/keys)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# ─── 3. Anthropic Claude (Optional / Paid: https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Merchant config ──────────────────────────────────────────────────────────
MERCHANT_ID=demo_merchant_001
MERCHANT_NAME=GreenLeaf Organics
# Custom UPI VPA handle for dynamic QR codes (e.g. your_name@slice, your_name@okhdfcbank)
MERCHANT_UPI_VPA=rzp.greenleaf@hdfcbank

# ─── Agent spending limit (₹) — simulates NPCI UAP per-session cap ────────────
AGENT_SPENDING_LIMIT_INR=2000

# ─── Storage paths ────────────────────────────────────────────────────────────
CHROMA_DB_PATH=./data/catalog_db
AUDIT_LOG_PATH=./data/audit.db
